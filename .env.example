# Copy this file to .env and fill in the values. Never commit .env.

# PostgreSQL connection string from the Neon dashboard.
# Use the direct connection: turn off "Connection pooling" when copying it.
DATABASE_URL=

# all = API and worker in one process. api or worker = only that part.
RUN_MODE=all

PORT=3000

# Keep false outside local testing. It blocks HTTP steps from calling private network addresses.
ALLOW_PRIVATE_URLS=false
