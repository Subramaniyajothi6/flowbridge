# Copy this file to .env and fill in the values. Never commit .env.

# PostgreSQL connection string from the Neon dashboard.
# Use the direct connection: turn off "Connection pooling" when copying it.
# Change sslmode=require to sslmode=verify-full in the copied value.
DATABASE_URL=

# Encrypts stored credentials. Create a value with:
#   node -e "console.log('k1:' + require('crypto').randomBytes(32).toString('base64'))"
# Losing this makes saved connections unreadable, so keep a safe copy.
ENCRYPTION_KEYS=

# From a Google Cloud OAuth client. Only needed for Gmail and Google Sheets.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# The public address once deployed. Leave empty when running locally.
PUBLIC_URL=

# all = API and worker in one process. api or worker = only that part.
RUN_MODE=all

PORT=3000

# Keep false outside local testing. It blocks HTTP steps from calling private network addresses.
ALLOW_PRIVATE_URLS=false
