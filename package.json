{
  "name": "flowbridge",
  "private": true,
  "workspaces": [
    "apps/*"
  ],
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "npm run dev --workspace apps/server",
    "build": "npm run build --workspace apps/web",
    "start": "npm start --workspace apps/server",
    "test": "npm test --workspace apps/server",
    "typecheck": "npm run typecheck --workspace apps/server && npm run typecheck --workspace apps/web",
    "db:generate": "npm run db:generate --workspace apps/server",
    "db:migrate": "npm run db:migrate --workspace apps/server"
  }
}
